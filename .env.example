# BreachBenchmark environment template.
# Copy to `.env` and fill in. The harness reads these LAZILY: importing the
# package or enumerating the grid never touches these values or the network.
# A key is only resolved when an adapter actually makes its first call.

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google Gemini ---
GEMINI_API_KEY=

# --- Groq (Llama) ---
GROQ_API_KEY=

# Optional: override the config file the CLI loads.
# BREACHBENCH_EXPERIMENT_CONFIG=config/experiment.yaml
