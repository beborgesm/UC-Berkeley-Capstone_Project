# ── Secrets (NEVER commit) ───────────────────────────────────────────────
.env
.env.*
!.env.example

# Private working context for AI coding assistants.
CLAUDE.md

# ── Python / tooling ─────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# ── OS / editor junk ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── Runtime scratch vs published data ────────────────────────────────────
# A live run writes to output/ and runs/. Those are working directories and stay
# ignored — the PUBLISHED, frozen copies live in data/ and results/ and ARE committed
# (see data/README.md). Keeping them separate means re-running the harness can never
# overwrite the collected dataset, which cannot be regenerated.
#
# If you are tempted to add a blanket `*.csv` rule here: don't. That is what kept the
# whole 480-trial dataset off GitHub in the first place.
output/
runs/

# ── Local archive: the superseded temperature-0.7 generation ─────────────
# 320 runs at target temperature 0.7, re-run at 1.0 once the roster required it. Kept
# on disk for provenance but not published; its result is reported in
# docs/TEMPERATURE_ABLATION.md.
output_baseline_0.7/
runs_baseline_0.7/
